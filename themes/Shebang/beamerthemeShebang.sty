\def\shebang@file{}
\newcommand\shebangfile[1]{\def\shebang@file{#1}}

% Helper function to manage spaces in the name.
\ExplSyntaxOn
\cs_new:Npn \shebang@jobname
    {
        \tl_set:Nx \l_tmpa_tl { \jobname }
        \tl_remove_all:Nn \l_tmpa_tl { " }
        \tl_if_in:NnTF \l_tmpa_tl { ~ }
            { \textquotesingle \tl_use:N \l_tmpa_tl .tex \textquotesingle }
            { \tl_use:N \l_tmpa_tl .tex }
    }
\ExplSyntaxOff

\newcommand\shebang@filename{%
    \ifx\shebang@file\@empty \shebang@jobname
    \else \shebang@file \fi
}


% The terminal cursor, as a pre-defined item
\newcommand\shebang@cursor{{\color{ShebangAccent}\rule[-0.15em]{0.55em}{1.05em}}}

% prompt line
\newcommand\shebang@cmd[1]{%
    {\color{ShebangAccent}\$}\ {\color{ShebangMuted}#1}\par%
    \vskip0.15cm%
}

% if blank
\newcommand\shebang@ifblank[3]{%
    \setbox0\hbox{#1}%
    \ifdim\wd0=0pt #2\else #3\fi%
}



% - - - - - - - - - - - -
% 5. Title Page
% - - - - - - - - - - - -

% title CLI line
% "head -n 2" if there is a subtitle,
% "head -n 1" if there isn't.

\setbeamertemplate{title page}{%
    \vskip0.4cm
    \shebang@ifblank{\insertsubtitle}%
        {\shebang@cmd{head -n 1 \shebang@filename}}%
        {\shebang@cmd{head -n 2 \shebang@filename}}%
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}%
    \shebang@ifblank{\insertsubtitle}{}{%
        \vskip0.2cm
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}%
    }%
    \vskip0.6cm
    \shebang@ifblank{\insertauthor}{}{%
        \shebang@cmd{whoami}%
        {\insertauthor
        \shebang@ifblank{\insertinstitute}{}%
            {\ {\color{ShebangMuted}@ \insertinstitute}}\par}%
        \vskip0.4cm}%
    \shebang@ifblank{\insertdate}{}{%
        \shebang@cmd{date}%
        {\insertdate\par}%
        \vskip0.4cm}%
    {\color{ShebangAccent}\$}\ \shebang@cursor%

}

\setbeamertemplate{section page}{%
    \raggedright
    \shebang@cmd{cd \shebang@path}%
    \vskip0.1cm
    {\usebeamerfont{section title}\color{ShebangInk}%
    \insertsectionhead\ \shebang@cursor\par}
}


\ExplSyntaxOn
\cs_new_protected:Npn \shebang@slug #1
    {
        \tl_set:Ne \l_tmpa_tl { \text_purify:n {#1} }
        \tl_set:Ne \l_tmpa_tl { \text_lowercase:V \l_tmpa_tl }
        \tl_replace_all:Nnn \l_tmpa_tl { ~ } { - }
        \tl_use:N \l_tmpa_tl
    }
\cs_generate_variant:Nn \text_lowercase:n { V }
\cs_new:Npn \shebang@twodigits #1
    { \int_compare:nNnT {#1} < { 10 } { 0 } \int_eval:n {#1} }
\ExplSyntaxOff

\newcommand\shebang@path{%
    \ifbeamer@inappendix
        \textasciitilde/appendix%
    \else\ifnum\insertsectionnumber>0
        \textasciitilde/\shebang@twodigits{\insertsectionnumber}-\shebang@slug{\secname}%
    \else
        \textasciitilde
    \fi\fi%
}

\newcommand\shebang@where{%
  \ifbeamer@inappendix
    \ {\color{ShebangMuted}|}\ Appendix%
  \else\ifnum\insertsectionnumber>0
    \ {\color{ShebangMuted}|}\ \insertsectionhead
  \fi\fi%
}

% - - - - - - - - - - - -
%  6. Frame Title 
% - - - - - - - - - - - -

\setbeamertemplate{frametitle}{%
    \vskip0.7cm
    {\usebeamerfont{prompt}\color{ShebangMuted}%
    \shebang@path\ {\color{ShebangAccent}\$}\par}%
    \vskip0.12cm
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}%
    \insertframetitle\ \shebang@cursor\par}%
    \shebang@ifblank{\insertframesubtitle}{}{%
        \vskip0.1cm
        {\usebeamerfont{framesubtitle}\color{ShebangMuted}%
        \#\ \insertframesubtitle\par}%
    }%
    \vskip0.1cm%
}

% - - - - - - - - - - - -
% 7. Footline 
% - - - - - - - - - - - -

\ExplSyntaxOn
\cs_new:Npn \shebang@progress
    {
        \int_set:Nn \l_tmpa_int
            { \int_min:nn { 10 } 
            { ( 10* \insertframenumber ) / \int_max:nn { 1 } { \inserttotalframenumber } } }
        [
            { \color{ShebangAccent} \prg_replicate:nn { \l_tmpa_int } { \# } }
            { \color{ShebangMuted} \prg_replicate:nn { 10 - \l_tmpa_int } { . } }
        ]
            
    }
\ExplSyntaxOff

\setbeamerfont{footline}{size=\scriptsize}
\setbeamertemplate{navigation symbols}{}       % no beamer nav icons

\setbeamertemplate{footline}{%
  \begin{tikzpicture}[x=1cm, y=1cm]
    % the bar itself, full width
    \fill[ShebangTrack] (0,0) rectangle (\paperwidth,0.55);
    % name box on the left, in the chrome colour
    \node[fill=ShebangAccent, text=ShebangOnAccent, anchor=west,
          minimum height=0.55cm, inner xsep=0.3cm,
          font=\usebeamerfont{footline}\bfseries] (mode) at (0,0.275)
         {\insertshortauthor};
    % short title | section, just after the box
    \node[text=ShebangInk, anchor=west] at ([xshift=0.3cm]mode.east)
         {\insertshorttitle\shebang@where};
    % progress and frame count on the right
    \node[text=ShebangInk, anchor=east] at (\paperwidth-0.3cm,0.275)
         {\ifshebang@progressbar\shebang@progress\quad\fi
          \insertframenumber/\inserttotalframenumber};
  \end{tikzpicture}
}

% - - - - - - - - - - - -
% 8. Lists 
% - - - - - - - - - - - -

% itemize, three levels
\setbeamertemplate{itemize item}{{\color{ShebangAccent}\textgreater}}
\setbeamertemplate{itemize subitem}{{\color{ShebangHighlight}-}}
\setbeamertemplate{itemize subsubitem}{{\color{ShebangMuted}*}}

% enumerate, three levels
\setbeamertemplate{enumerate item}{{\color{ShebangAccent}[\insertenumlabel]}}
\setbeamertemplate{enumerate subitem}{{\color{ShebangHighlight}[\alph{enumii}]}}
\setbeamertemplate{enumerate subsubitem}{{\color{ShebangMuted}[\roman{enumiii}]}}


% - - - - - - - - - - - -
% 9. Table of Contents 
% - - - - - - - - - - - -

\pretocmd{\tableofcontents}{%
  {\color{ShebangAccent}\$}\ {\color{ShebangMuted}ls}\par
  \vskip0.25cm
}{}{%
  \PackageWarning{beamerthemeShebang}{Could not add `ls' to the agenda}
}


\newcommand\shebang@tocentry[3]{%
  \begingroup
    \let\shebang@hyperlink\hyperlink                % remember the real one
    \renewcommand\hyperlink[2]{%                    % same link, new text
      \shebang@hyperlink{##1}{#1\shebang@slug{##2}#2}}%
    #3%
  \endgroup
}


\patchcmd{\beamer@sectionintoc}{\vfill}{\vskip0.35em}{}{%
  \PackageWarning{beamerthemeShebang}{Could not tighten the agenda spacing}
}

\setbeamertemplate{section in toc}{%
  {\color{ShebangAccent}%
   \shebang@tocentry{\shebang@twodigits{\inserttocsectionnumber}-}{/}{\inserttocsection}}\par%
}

\setbeamertemplate{section in toc shaded}{%
  {\color{ShebangMuted}%
   \shebang@tocentry{\shebang@twodigits{\inserttocsectionnumber}-}{/}{\inserttocsection}}\par%
}

\setbeamertemplate{subsection in toc}{%
  \hspace*{2ex}{\color{ShebangInk}%
   \shebang@tocentry{}{}{\inserttocsubsection}}\par%
}

\setbeamertemplate{subsection in toc shaded}{%
  \hspace*{2ex}{\color{ShebangMuted}%
   \shebang@tocentry{}{}{\inserttocsubsection}}\par%
}



\AtBeginSection{%
  \ifshebang@sectionpage
    \begingroup
      \setbeamertemplate{footline}{}%
      \frame[c, noframenumbering]{\sectionpage}%
    \endgroup
  \fi
}

% - - - - - - - - - - - -
% 11. Standout page 
% - - - - - - - - - - - -


\setbeamerfont{standout}{size=\Huge, series=\bfseries}

\newcommand\shebangprompt[1][Y/n]{%
  \if\relax\detokenize{#1}\relax\else 
    {\mdseries[#1]}%
  \fi
  \par
  {\mdseries\textgreater}}

\newcommand\shebangcursor{\rule[-0.15em]{0.55em}{1.05em}}

\newif\ifshebang@standout
\define@key{beamerframe}{standout}[true]{%
  \setkeys{beamerframe}{c, noframenumbering}% centred vertically, not counted
  \shebang@standouttrue
  \begingroup                                % closed again after the frame
    \setbeamercolor{background canvas}{bg=ShebangAccent}%
    \setbeamercolor{normal text}{fg=ShebangOnAccent, bg=ShebangAccent}%
    \setbeamercolor{alerted text}{fg=ShebangOnAccent}%
    \setbeamertemplate{footline}{}%
    \raggedright\usebeamerfont{standout}\color{ShebangOnAccent}
}

% - - - - - - - - - - - -
% 12. Blocks 
% - - - - - - - - - - - -


\tcbset{
  shebang block/.style={
    enhanced,                     
    sharp corners,                
    boxrule=0.6pt,               
    colframe=#1,
    colback=ShebangPaper,        
    coltext=ShebangInk,
    fontupper=\usebeamerfont{block body},
    left=2.5mm, right=2.5mm, top=2.6mm, bottom=1.5mm,
    before skip=0.8ex, after skip=0.8ex,
    % the title sits ON the top line, with a patch of background colour
    % behind it that "cuts" the line:  ┌─ Title ───┐
    attach boxed title to top left={xshift=3mm, yshift=-2mm},
    boxed title style={
      sharp corners, boxrule=0pt,
      colback=ShebangPaper, colframe=ShebangPaper,
      left=1mm, right=1mm, top=0pt, bottom=0pt},
    coltitle=#1,
    fonttitle=\usebeamerfont{block title},
  },
}

\newcommand\shebang@blockbox[2]{%
  \shebang@ifblank{\insertblocktitle}%
    {\begin{tcolorbox}[shebang block=#1, top=1.5mm]}%
    {\begin{tcolorbox}[shebang block=#1, title={#2\insertblocktitle}]}}

\setbeamertemplate{block begin}{\shebang@blockbox{ShebangMuted}{}}
\setbeamertemplate{block end}{\end{tcolorbox}}

\setbeamertemplate{block alerted begin}{\shebang@blockbox{ShebangAlert}{error: }}
\setbeamertemplate{block alerted end}{\end{tcolorbox}}

\setbeamertemplate{block example begin}{\shebang@blockbox{ShebangAccent}{\#\ }}
\setbeamertemplate{block example end}{\end{tcolorbox}}



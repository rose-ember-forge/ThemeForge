  % Maths: newtxmath, a sturdy serif that holds its own next to Plex Mono.
  \IfFileExists{newtxmath.sty}{%
    \RequirePackage{newtxmath}%
  }{%
    \PackageWarning{beamerthemeShebang}{newtxmath not found, using the
      default maths font. Install it with:
      tlmgr install newtx}%
  }
\fi


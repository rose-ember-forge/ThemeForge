% Contrast check for custom accent colours
\ExplSyntaxOn
\cs_new_protected:Npn \shebang@luminance #1#2
  {
    % ask xcolor for the colour as "r,g,b" with values from 0 to 1
    \extractcolorspecs {#1} \l_tmpa_tl \l_tmpb_tl
    \convertcolorspec {\l_tmpa_tl} {\l_tmpb_tl} {rgb} \l_tmpa_tl
    \exp_after:wN \shebang@luminance@rgb \l_tmpa_tl \q_stop #2
  }
\cs_new_protected:Npn \shebang@luminance@rgb #1,#2,#3 \q_stop #4
  {
    % undo the screen's gamma curve for each channel, then weight them the
    % way the eye does: green counts most, blue least
    \cs_set:Npn \shebang@lin ##1
      { ( ##1 <= 0.03928 ? ##1 / 12.92 : ( ( ##1 + 0.055 ) / 1.055 ) ^ 2.4 ) }
    \tl_set:Ne #4
      {
        \fp_eval:n
          { 0.2126 * \shebang@lin{#1} + 0.7152 * \shebang@lin{#2}
            + 0.0722 * \shebang@lin{#3} }
      }
  }

% contrast ratio of two luminances: (lighter + 0.05) / (darker + 0.05)
\cs_new:Npn \shebang@contrast #1#2
  { \fp_eval:n { ( max(#1,#2) + 0.05 ) / ( min(#1,#2) + 0.05 ) } }
\ExplSyntaxOff


\ifx\shebang@accent\@empty\else
  \definecolor{ShebangAccent}{HTML}{\shebang@accent}
  \shebang@luminance{ShebangAccent}\shebang@L@accent
  \shebang@luminance{ShebangInk}\shebang@L@ink
  \shebang@luminance{ShebangPaper}\shebang@L@paper
  \edef\shebang@C@ink{\shebang@contrast{\shebang@L@accent}{\shebang@L@ink}}
  \edef\shebang@C@paper{\shebang@contrast{\shebang@L@accent}{\shebang@L@paper}}
  % keep whichever contrasts more
  \ExplSyntaxOn
  \fp_compare:nNnTF { \shebang@C@ink } > { \shebang@C@paper }
    { \colorlet{ShebangOnAccent}{ShebangInk}
      \cs_set:Npe \shebang@C@best { \shebang@C@ink } }
    { \colorlet{ShebangOnAccent}{ShebangPaper}
      \cs_set:Npe \shebang@C@best { \shebang@C@paper } }
  \fp_compare:nNnT { \shebang@C@best } < { 4.5 }
    {
      \PackageWarning{beamerthemeShebang}{accent=\shebang@accent\space
        is~hard~to~read~text~on~(best~contrast~
        \fp_eval:n { round(\shebang@C@best, 1) }:1,~WCAG~AA~needs~4.5:1)}
    }
  % The accent is also used AS text on the slide background (bullets, the
  % prompt $, code keywords), so check that direction too.
  \fp_compare:nNnT { \shebang@C@paper } < { 4.5 }
    {
      \PackageWarning{beamerthemeShebang}{accent=\shebang@accent\space
        is~faint~as~text~on~this~variant's~background~(
        \fp_eval:n { round(\shebang@C@paper, 1) }:1,~WCAG~AA~needs~4.5:1)}
    }
  \ExplSyntaxOff
\fi



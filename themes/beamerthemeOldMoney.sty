% - - - - - - - - - - - -
% - - - - - - - - - - - -
%  beamerthemeOldMoney.sty
%  Part of the ThemeForge Collection
%  Dark background, ivory text, gold ornaments
%  Vibes of engraved invitation cards
%
%  Usage:     \usetheme[options]{OldMoney}
%
%  Options: variant = ink|emerald|ivory   colour scheme (default ink)
% - - - - - - - - - - - -
% - - - - - - - - - - - -
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeMeridian}[ThemeForge 20260705 OldMoney Theme v.1]

\mode<presentation>

% - - - - - - - - - - - -
% 1. Options 
% - - - - - - - - - - - -

\def\OM@variant{ink}
\DeclareOptionsBeamer{variant}{\def\OM@variant{#1}}
\ProcessOptionsBeamer

\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric} % For the diamond ornaments


% - - - - - - - - - - - -
% 2. Colours 
% - - - - - - - - - - - -

% Variant Ink
\def\OM@variant@ink{
    \definecolor{OM-bg}{HTML}{0A0213}
    \definecolor{OM-panel}{HTML}{181731}
    \definecolor{OM-text}{HTML}{F1DEE4}
    \definecolor{OM-gold}{HTML}{B68600}
    \definecolor{OM-item}{HTML}{22D9A5}
    \definecolor{OM-fill}{HTML}{48659C}
    \definecolor{OM-alert}{HTML}{E8836B}
    \definecolor{OM-example}{HTML}{8FBF8F}
}

% Variant Emerald
\def\OM@variant@emerald{
    \definecolor{OM-bg}{HTML}{0B241D}
    \definecolor{OM-panel}{HTML}{153A30}
    \definecolor{OM-text}{HTML}{F3EBDD}
    \definecolor{OM-gold}{HTML}{CFA43E}
    \definecolor{OM-item}{HTML}{7FD8C1}
    \definecolor{OM-fill}{HTML}{3E7A68}
    \definecolor{OM-alert}{HTML}{F09A80}
    \definecolor{OM-example}{HTML}{B5DBA8}
}

% Variant Ivory
\def\OM@variant@ivory{
    \definecolor{OM-bg}{HTML}{F6F0E4}
    \definecolor{OM-panel}{HTML}{EDE5D3}
    \definecolor{OM-text}{HTML}{1E1A14}
    \definecolor{OM-gold}{HTML}{7A5A00}
    \definecolor{OM-item}{HTML}{0E6B58}
    \definecolor{OM-fill}{HTML}{3D5A8A}
    \definecolor{OM-alert}{HTML}{A8402A}
    \definecolor{OM-example}{HTML}{3F6A35}
}

\ifcsname OM@variant@\OM@variant\endcsname
    \csname OM@variant@\OM@variant\endcsname
\else
    \PackageWarning{beamerthemeOldMoney}{Unknown variant '\OM@variant', using 'ink'. Choose ink, emerald, or ivory.}%
    \OM@variant@ink
\fi

\colorlet{OM-Muted}{OM-text!62!OM-bg}

\setbeamercolor{title}{fg = OM-gold}
\setbeamercolor{subtitle}{fg = OM-text}
\setbeamercolor{author}{fg = OM-text}
\setbeamercolor{institute}{fg = OM-item}
\setbeamercolor{date}{fg = OM-muted}
\setbeamercolor{frametitle}{fg = OM-gold}
\setbeamercolor{framesubtitle}{fg = OM-text}
\setbeamercolor{section title}{fg = OM-gold}
\setbeamercolor{footline}{fg = OM-muted}
\setbeamercolor{block title}{fg = OM-gold}
\setbeamercolor{block title alerted}{fg = OM-alert}
\setbeamercolor{block title example}{fg = OM-example}
\setbeamercolor{standout}{fg = OM-bg, bg = OM-text}

% - - - - - - - - - - - -
%  3. Fonts
% - - - - - - - - - - - -

\IfFileExists{plex-serif.sty}{\RequirePackage{plex-serif}}{%
    \PackageWarning{beamerthemeOldMoney}{Plex Serif not found, using default fonts.\MessageBreak Install TeX Live package `plex'.}
}
\IfFileExists{plex-mono.sty}{\RequirePackage{plex-mono}}{%
    \PackageWarning{beamerthemeOldMoney}{Plex Mono not found, using default fonts.\MessageBreak Install TeX Live package `plex'.}
}
\usefonttheme{serif}

\setbeamerfont{title}{size = \huge, series = \bfseries}
\setbeamerfont{subtitle}{size = \large, series = \mdseries, shape = \itshape}
\setbeamerfont{author}{size = \normalsize}
\setbeamerfont{institute}{size = \small, shape = \scshape}
\setbeamerfont{date}{size = \small}
\setbeamerfont{frametitle}{size = \Large, series = \bfseries}
\setbeamerfont{framesubtitle}{size = \normalsize, shape = \mdseries, shape = \itshape}
\setbeamerfont{section title}{size = \LARGE, series = \bfseries}
\setbeamerfont{section number}{size = \small, shape = \scshape}
\setbeamerfont{footline}{size = \tiny}
\setbeamerfont{block title}{size = \normalsize, series = \bfseries}

 
% - - - - - - - - - - - -
% 4. Ornaments 
% - - - - - - - - - - - -


\newcommand{\OMrule}[1]{%
    \tikz{%
        \draw[OM-gold, line width = 0.6pt] (3pt,0) -- (#1-3pt, 0)
        \node[diamond, fill = OM-gold, inner sep = 1.3pt] at (3pt, 0) {};
        \node[diamond, fill = OM-gold, inner sep = 1.3pt] at (#1-3pt, 0) {};
    }%
}

\newcommand\OMifempty[3]{%
  \sbox0{#1}%
  \ifdim\wd0=0pt #2\else #3\fi
}


% - - - - - - - - - - - -
% 5. Outer Theme 
% - - - - - - - - - - - -

% Take out navigation symbols
\setbeamertemplate{navigation symbols}{}

% Title page
\newif\ifOM@subtitle
\setbeamertemplate{title page}{%
    \OMifempty{\insertsubtitle}{\OM@subtitlefalse}{\OM@subtitletrue}%
    \begin{tikzpicture}[remember picture, overlay]
        \draw[OM-gold, line width = 0.8pt]
            ([xshift = 0.035\paperwidth, yshift = 0.05\paperheight]current page.south west) rectangle %
            ([xshift = -0.035\paperwidth, yshift = -0.05\paperheight]current page.north east);
            
        \draw[OM-gold, line width = 0.4pt]
            ([xshift = 0.045\paperwidth, yshift = 0.065\paperheight]current page.south west) rectangle %
            ([xshift = -0.045\paperwidth, yshift = -0.065\paperheight]current page.north east);
        
        \node[text width = 0.75\paperwidth, align = center, anchor = south] 
            at ([yshift = 0.08\paperheight] current page.center) (Title)
            {\usebeamerfont{title}\usebeamercolor[fg]{title}%
            \hyphenpenalty = 10000% Titles are never to be hyphenated
            \inserttitle\par};

        % If there is a subtitle, the Rule goes under it.
        % Otherwise, the Rule anchors itself to the bottom of the title
        \ifOM@subtitle
            \node[text width = 0.75\paperwidth, align = center, anchor = north] at ([yshift = -0.5ex] Title.south) (Subtitle) {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par};
            \coordinate (Rule) at ([yshift = -2.5ex] Subtitle.south);
        \else
            \coordinate (Rule) at ([yshift = -2.5ex] Title.south);
        \fi

        % Ornament
        \node[inner sep = 0pt] at (Rule) (Ornament) {\OMRule{0.22\paperwidth}};

        % Author, institute, and date stacked under the ornament
        \node[text width = 0.75\paperwidth, align = center, anchor = north] at ([yshift = -2.5ex] Ornament.south)
            {%
                {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertrauthot\par}
                \OMifempty{\insertinstitute}{}{%
                    \vskip0.6ex
                    {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
                }
                \vskip0.6ex
                {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
            };
    \end{tikzpicture}%
}

\setbeamertemplate{frametitle}{%
    \vskip2ex
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
    \ifx\insertframesubtitle\@empty\else
        \vskip0.3ex
        {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi
    \vskip1ex
    \OMrule{\linewidth}%
}


\setbeamertemplate{footline}{%
    \leavevmode
    \hbox to \paperwidth{%
        \hskip0.05\paperwidth
	    \usebeamerfont{footline}\usebeamercolor[fg]{footline}%
	    \sbox0{\insertshortauthor}%
	    \sbox1{\insertshorttitle}%
	    \ifdim\wd0>0pt
	       \insertshortauthor
	        \ifdim\wd1>0pt\enspace{\color{OM-gold}|}\enspace\insertshorttitle\fi
	    \else
	        \ifdim\wd1>0pt\insertshortttile\fi
	    \fi
	    \hfill
	    \insertframenumer\,/\,\inserttotalframenumber
	    \hskip0.05\paperwidth
    }%
    \vskip2.5ex
}

\setbeamertemplate{section page}{%
    \centering
    {\usebeamerfont{section number}\usebeamercolor[fg]{structure}%
        Section \insertsectionnumber\par}
    \vskip1.5ex
    {\usebeamerfont{section title}\usebeamercolor[fg]{section title}\insertsectionhead\par}
    \vskip2ex
    \OMrule{0.22\paperwidth}\par
}

\AtBeginSection{%
    \ifbeamer@inframe\else
    \begingroup
        \setbeamertemplate{footline}{}
        \frame[c, noframenumbering]{\sectionpage}
    \endgroup
    \fi
}


% - - - - - - - - - - - -
% 6. Inner Theme
% - - - - - - - - - - - -

\setbeamersize{%
    text margin left = 0.05\paperwidth,
    text margin right = 0.05\paperwidth
}

% Lists

% Itemize
\setbeamertemplate{itemize item}{%
    \raisebox{0.25ex}{\tikz{\fill[OM-teal, rotate = 45] (0,0) rectangle (0.55ex, 0.55ex);}}%
}

\setbeamertemplate{itemize subitem}{%
    \raisebox{0.3ex}{\tikz{\fill[OM-gold, line width = 0.5pt, rotate = 45] (0,0) rectangle (0.45ex, 0.45ex);}}%
}

\setbeamertemplate{itemize subsubitem}{%
    \raisebox{0.4ex}{\tikz{\fill[OM-teal] (0,0) circle (0.18ex);}}%
}


% Enumerate
\setbeamertemplate{enumerate item}{%
    {\usebeamercolor[fg]{structure}\insertenumlabel.}%
}

\setbeamertemplate{enumerate subitem}{%
    {\color{OM-gold}\insertsubenumlabel.}%
}

\setbeamertemplate{enumerate subsubitem}{%
    {\color{OM-gold}\insertsubsubenumlabel.}%
}

\setbeamertemplate{blocks}[rounded][shadow = false]

\setbeamertemplate{section in toc}{%
    {\color{OM-gold}\inserttocsectionnumber.}\enspace\inserttocsection\par
}

\RequirePackage{etoolbox}
\newif\ifOM@standout
\define@key{beamerframe}{standout}[true]{%
    \setkeys{beamerframe}{c, noframenumbering}%
    \OM@standouttrue
    \begingroup
    \setbeamercolor{background canvas}{bg = OM-gold}%
    \centering\usebeamerfont{title}\color{OM-bg}%
}

\apptocmd{\beamer@reseteecodes}{%
    \if@OMstandout\endgroup\global\OM@standoutfalse\fi}{}{}

\setbeamertemplate{caption}[numbered]
\setbeamercolor{caption name}{fg = OM-gold}

\mode<all>
\endinput

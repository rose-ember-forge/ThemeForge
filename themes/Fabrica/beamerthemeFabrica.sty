%
%  An editorial theme.
%  Warm tones and serif typography.
%  Usage:     \usetheme{Fabrica}
%             \usetheme[options]{Fabrica}
%
%  Options:   variant = paper|linen|walnut    colour scheme (default paper)
%             accent = <HEX>                  override the variant's accent colour
%             body = serif|sans               typeface for body text (default serif. Titles stay serif despite sans body)
%             progressbar = true|false        hairline progress bar (default false)
%             sectionpage = true|false        (default true)
%             fonts = true|false              load Libertinus fonts if installed
%   
% - - - - - - - - - - - -
% - - - - - - - - - - - -
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeFabrica}[2026/10/19 v0.1 ThemeForge Fabrica theme]

\mode<presentation>

% - - - - - - - - - - - -
% 1. Options
% - - - - - - - - - - - -
\newif\iffabrica@progressbar    \fabrica@progressbarfalse
\newif\iffabrica@sectionpage    \fabrica@sectionpagetrue
\newif\iffabrica@fonts          \fabrica@fontstrue
\newif\iffabrica@serifbody      \fabrica@serifbodytrue

\def\fabrica@accent{}
\def\fabrica@variant{paper}

\DeclareOptionBeamer{variant}{\def\fabrica@variant{#1}}
\DeclareOptionBeamer{accent}{\def\fabrica@accent{#1}}
\DeclareOptionBeamer{body}{%
    \def\fabrica@tmp{#1}\def\fabrica@sans{sans}%
    \ifx\fabrica@tmp\fabrica@sans\fabrica@serifbodyfalse\else\fabrica@serifbodytrue\fi}
\DeclareOptionBeamer{progressbar}[true]{\csname fabrica@progressbar#1\endcsname}
\DeclareOptionBeamer{sectionpage}[true]{\csname fabrica@sectionpage#1\endcsname}
\DeclareOptionBeamer{fonts}[true]{\csname fabrica@fonts#1\endcsname}
\ProcessOptionsBeamer

\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{etoolbox}

\providecommand{\themeforge@ifblank}[3]{%
    \setbox0 \hbox{\let\\\relax#1}%
    \ifdim\wd0=0pt #2\else #3\fi}


% - - - - - - - - - - - -
% 2. Colours
% - - - - - - - - - - - -

% Variant paper
\def\fabrica@variant@paper{%
    \definecolor{FabricaPaper}{HTML}{F7F2E8}
    \definecolor{FabricaPanel}{HTML}{EDE4D3}
    \definecolor{FabricaInk}{HTML}{2A2421}
    \definecolor{FabricaMuted}{HTML}{6B5E55}
    \definecolor{FabricaRule}{HTML}{CDBFA8}
    \definecolor{FabricaAccent}{HTML}{A8432A}
    \definecolor{FabricaAlert}{HTML}{D02032}
    \definecolor{FabricaExample}{HTML}{48612A}
}

% Variant linen
\def\fabrica@variant@linen{%
    \definecolor{FabricaPaper}{HTML}{F2F3F0}
    \definecolor{FabricaPanel}{HTML}{E3E6E1}
    \definecolor{FabricaInk}{HTML}{1F2326}
    \definecolor{FabricaMuted}{HTML}{575E63}
    \definecolor{FabricaRule}{HTML}{BFC6C2}
    \definecolor{FabricaAccent}{HTML}{2F5D8A}
    \definecolor{FabricaAlert}{HTML}{9A2530}
    \definecolor{FabricaExample}{HTML}{3F6630}
}

% Variant walnut
\def\fabrica@variant@walnut{%
    \definecolor{FabricaPaper}{HTML}{241C17}
    \definecolor{FabricaPanel}{HTML}{33281F}
    \definecolor{FabricaInk}{HTML}{F2E8DA}
    \definecolor{FabricaMuted}{HTML}{C2B29F}
    \definecolor{FabricaRule}{HTML}{5A4A3C}
    \definecolor{FabricaAccent}{HTML}{E0A458}
    \definecolor{FabricaAlert}{HTML}{F08C7A}
    \definecolor{FabricaExample}{HTML}{A9C98A}
}

\ifcsname fabrica@variant@\fabrica@variant\endcsname
    \csname fabrica@variant@\fabrica@variant\endcsname
\else
    \PackageWarning{beamerthemeFabrica}{Unknown variant '\fabrica@variant', using 'paper'. Choose paper, linen, or walnut.}%
    \fabrica@variant@paper
\fi

\ifx\fabrica@accent\@empty\else
    \definecolor{FabricaAccent}{HTML}{\fabrica@accent}
\fi

\setbeamercolor{normal text}{fg=FabricaInk, bg=FabricaPaper}
\setbeamercolor{background canvas}{bg=FabricaPaper}
\setbeamercolor{structure}{fg=FabricaAccent}
\setbeamercolor{alerted text}{fg=FabricaAlert}
\setbeamercolor{example text}{fg=FabricaExample}
\setbeamercolor{title}{fg=FabricaInk}
\setbeamercolor{subtitle}{fg=FabricaMuted}
\setbeamercolor{author}{fg=FabricaInk}
\setbeamercolor{institute}{fg=FabricaAccent}
\setbeamercolor{date}{fg=FabricaMuted}
\setbeamercolor{frametitle}{fg=FabricaInk}
\setbeamercolor{framesubtitle}{fg=FabricaMuted}
\setbeamercolor{section in head}{fg=FabricaAccent}
\setbeamercolor{footline}{fg=FabricaMuted}
\setbeamercolor{section number}{fg=FabricaAccent}
\setbeamercolor{section title}{fg=FabricaInk}
\setbeamercolor{block title}{fg=FabricaAccent}
\setbeamercolor{block title alerted}{fg=FabricaAlert}
\setbeamercolor{block title example}{fg=FabricaExample}
\setbeamercolor{caption name}{fg=FabricaAccent}

% - - - - - - - - - - - -
% 3. Fonts 
% - - - - - - - - - - - -

\RequirePackage{iftex}
\iffabrica@fonts
    \iftutex
    % XeLaTeX / LuaLaTex: load the Libertinus OpenType files directly
    \RequirePackage{fontspec}
    \IfFontExistsTF{LibertinusSerif-Regular.otf}{%
        \setmainfont{LibertinusSerif}[%
            Extension = .otf,
            UprightFont = *-Regular,
            Boldfont = *-Semibold,
            ItalicFont = *-Italic, 
            BoldItalicFont = *-SemiboldItalic
            ]%
        \setsansfont{LibertinusSans}[%
            Extension = .otf,
            UprightFont = *-Regular,
            Boldfont = *-Semibold,
            ItalicFont = *-Italic
        ]
        \setmonofont{LibertinusMono}[%
            Extension = .otf,
            UprightFont = *-Regular,
            Scale = 0.85
        ]%
    }{%
        \PackageWarning{beamerthemeFabrica}{Libertinus not found, using default font. \MessageBreak Install TeX Live package `libertinus'.}
    }
    \else
        \IfFileExists{libertinus.sty}{\RequirePackage{libertinus}}{%
            \PackageWarning{beamerthemeFabrica}{Libertinus not found, using the default font.\MessageBreak Install TeX Live package `libertinus'.}
        }
    \fi
\fi
\iffabrica@serifbody \usefonttheme{serif}\fi
\usefonttheme{professionalfonts}

\setbeamerfont{title}{family=\rmfamily, size=\huge, series=\mdseries}
\setbeamerfont{subtitle}{family=\rmfamily, size=\large, shape=\itshape}
\setbeamerfont{author}{size=\normalsize, shape=\scshape}
\setbeamerfont{institute}{size=\small, shape=\scshape}
\setbeamerfont{date}{size=\small, shape=\itshape}
\setbeamerfont{frametitle}{family=\rmfamily, size=\LARGE, series=\mdseries}
\setbeamerfont{framesubtitle}{family=\rmfamily, size=\normalsize, shape=\itshape}
\setbeamerfont{section in head}{size=\small, shape=\scshape}
\setbeamerfont{footline}{size=\scriptsize, shape=\scshape}
\setbeamerfont{section number}{family=\rmfamily, size=\fontsize{54}{56}\selectfont, shape=\itshape}
\setbeamerfont{section title}{family=\rmfamily, size=\huge}
\setbeamerfont{block title}{size=\normalsize, shape=\scshape}
\setbeamerfont{standout}{family=\rmfamily, size=\Huge, shape=\itshape}

% - - - - - - - - - - - -
% 4. Geometry 
% - - - - - - - - - - - -

\def\fabrica@margin{0.08\paperwidth}
\setbeamersize{text margin left = 0.08\paperwidth, text margin right = 0.08\paperwidth}
\setbeamertemplate{navigation symbols}{}

% Ornament line -- diamond -- line
\newcommand\fabrica@ornament[1][4em]{%
    \tikz[baseline = -0.6ex]{
        \draw[FabricaRule, line width = 0.6pt] (-#1,0) -- (-0.35em,0);
        \draw[FabricaRule, line width = 0.6pt] (0.35em, 0) -- (#1,0);
        \fill[FabricaAccent] (0,0.18em) -- (0.18em, 0) -- (0,-0.18em) -- (-0.18em,0) -- cycle;
    }
}

% - - - - - - - - - - - -
% 5. Title Page 
% - - - - - - - - - - - -

\setbeamertemplate{title page}{%
    \vfill
    \begin{minipage}{\textwidth}
        \centering
        \themeforge@ifblank{\insertinstitute}{}{%
            {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}\vskip2.5ex}
        {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
        \themeforge@ifblank{\insertsubtitle}{}{%
            \vskip1ex
            {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}}
        \vskip3ex
        \fabrica@ornament[5em]\par
        \vskip3ex
        {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
        \vskip0.6ex
        {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
    \end{minipage}
    \vfill
}

% - - - - - - - - - - - -
% 6. Frame Title 
% - - - - - - - - - - - -

\setbeamertemplate{frametitle}{%
    \nointerlineskip
    \begin{beamercolorbox}[
        wd = \paperwidth,
        leftskip = \fabrica@margin,
        rightskip = \fabrica@margin plus 1fil]{frametitle}
        \vskip2.6ex
        \noindent{\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}%
            \strut\insertframetitle}\hfill
        \themeforge@ifblank{\insertsectionhead}{}{%
            {\usebeamerfont{section in head}\usebeamercolor[fg]{section in head}\insertsectionhead}}\par
        \themeforge@ifblank{\insertframesubtitle}{}{%
            {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}}%
        \vskip0.9ex
        {\color{FabricaRule}\hrule height 0.6pt}%
        \vskip0.4ex
    \end{beamercolorbox}
}

% - - - - - - - - - - - -
% 7. Footline 
% - - - - - - - - - - - -

\newcommand{\fabrica@progressbar}{%
    \pgfmathsetmacro\fabrica@ratio{%
        min(1,\insertframenumber/max(1,\inserttotalframenumber))
    }%
    \begin{tikzpicture}
        \fill[FabricaRule] (0,0) rectangle (\paperwidth,1pt);
        \fill[FabricaAccent] (0,0) rectangle ({\aterlier@ratio*\paperwidth},1pt);
    \end{tikzpicture}}

\setbeamertemplate{footline}{%
    \begin{beamercolorbox}[
        wd = \paperwidth,
        ht = 2.6ex,
        dp = 2.4ex,
        center
    ]{footline}
        \usebeamerfont{footline}
        \insertshorttitle\enspace\raisebox{0.35ex}{\tikz\fill[FabricaAccent] (0,0) circle (0.12em);}\enspace\insertframenumber
    \end{beamercolorbox}%
    \iffabrica@progressbar\par\nointerlineskip\fabrica@progressbar\fi
}

% - - - - - - - - - - - -
% 8. Section divider slides 
% - - - - - - - - - - - -

\setbeamertemplate{section page}{%
    \begin{minipage}{\textwidth}
        \centering
        {\usebeamerfont{section number}\usebeamercolor[fg]{section number}%
            \Roman{section}\par}
        \vskip1.5ex
        {\usebeamerfont{section title}\usebeamercolor[fg]{section title}\insertsectionhead\par}
        \vskip2.5ex
        \fabrica@ornament\par
    \end{minipage}%
}

\AtBeginSection{%
    \iffabrica@sectionpage
        \begingroup
            \setbeamertemplate{footline}{}%
            \frame[c,noframenumbering]{\sectionpage}%
        \endgroup
    \fi
}

% - - - - - - - - - - - -
% 9. Lists and ToC 
% - - - - - - - - - - - -

% Itemize list, three levels
\setbeamertemplate{itemize item}{%
    \raisebox{0.5ex}{\tikz\fill[FabricaAccent] (0,0) rectangle (0.65em,0.09em);}
}
\setbeamertemplate{itemize subitem}{%
    \raisebox{0.45ex}{\tikz\fill[FabricaAccent] (0,0) circle (0.13em);}
}
\setbeamertemplate{itemize subsubitem}{%
    \raisebox{0.45ex}{\tikz\draw[FabricaAccent, line width = 0.4pt] (0,0) circle (0.12em);}
}

% Enumerate list, three levels
\setbeamertemplate{enumerate item}{{%
    \usebeamercolor[fg]{structure}%
    \rmfamily\itshape\insertenumlabel.
}}
\setbeamertemplate{enumerate subitem}{{%
    \usebeamercolor[fg]{structure}%
    \rmfamily\itshape\insertsubenumlabel
}}
\setbeamertemplate{enumerate subsubitem}{{%
    \usebeamercolor[fg]{structure}%
    \rmfamily\itshape\insertsubsubenumlabel
}}

\setlength{\leftmargini}{1.4em}
\AtBeginEnvironment{itemize}{\addtolength{\itemsep}{0.35ex}}
\AtBeginEnvironment{enumerate}{\addtolength{\itemsep}{0.35ex}}

\setbeamertemplate{section in toc}{%
    {\usebeamercolor[fg]{structure}\rmfamily\itshape\expandafter\uppercase\expandafter{\romannumeral\inserttocsectionnumber}.}%
    \hspace{0.8em}{\usebeamercolor[fg]{normal text}\rmfamily\inserttocsection}\par
}

\setbeamertemplate{subsection in toc}{%
    \hspace{2.2em}{\usebeamercolor[fg]{normal text}\small\inserttocsubsection}\par
}

% - - - - - - - - - - - -
% 10. Blocks 
% - - - - - - - - - - - -

\tcbset{
    fabrica/block/.style = {%
        enhanced,
        arc = 2pt,
        frame hidden, 
        boxrule = 0pt,
        colback = FabricaPanel,
        colbacktitle = FabricaPanel,
        coltitle = #1,
        colupper = FabricaInk,
        fonttitle = \usebeamerfont{block title},
        left = 10pt, 
        right = 10pt,
        top = 3pt, 
        bottom = 6pt, 
        toptitle = 6pt,
        bottomtitle = 0pt,
        titlerule = 0pt,
        before skip = 1ex,
        after skip = 1ex
    }%
}

\newcommand\fabrica@blockbegin[1]{%
    \par%
    \themeforge@ifblank{\insertblocktitle}%
        {\begin{tcolorbox}[fabrica/block = #1]}%
        {\begin{tcolorbox}[fabrica/block = #1, title = {\insertblocktitle}]}%
    \usebeamercolor[fg]{normal text}%
}

\setbeamertemplate{block begin}{\fabrica@blockbegin{FabricaAccent}}
\setbeamertemplate{block end}{\end{tcolorbox}}
\setbeamertemplate{block alerted begin}{\fabrica@blockbegin{FabricaAlert}}
\setbeamertemplate{block alerted end}{\end{tcolorbox}}
\setbeamertemplate{block example begin}{\fabrica@blockbegin{FabricaExample}}
\setbeamertemplate{block example end}{\end{tcolorbox}}

% - - - - - - - - - - - -
% 11. Misc 
% - - - - - - - - - - - -

\setbeamertemplate{caption}[numbered]
\setbeamerfont{caption}{size = \small, shape = \itshape}

\newif\iffabrica@standout
\define@key{beamerframe}{standout}[true]{%
    \setkeys{beamerframe}{c,noframenumbering}%
    \fabrica@standouttrue
    \begingroup
    \setbeamercolor{background canvas}{bg = FabricaInk}%
    \setbeamercolor{alerted text}{fg = AterlierPanel}%
    \setbeamertemplate{footline}{}%
    \centering\usebeamerfont{standout}\color{FabricaPaper}
}
\apptocmd{\beamer@reseteecodes}{%
    \iffabrica@standout\endgroup\global\fabrica@standoutfalse\fi}{}{}

\mode<all>
\endinput
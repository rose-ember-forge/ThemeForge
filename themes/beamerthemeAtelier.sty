    \definecolor{AtelierInk}{HTML}{2A2421}
    \definecolor{AtelierMuted}{HTML}{6B5E55}
    \definecolor{AtelierRule}{HTML}{CDBFA8}
    \definecolor{AtelierAccent}{HTML}{A8432A}
    \definecolor{AtelierAlert}{HTML}{962032}
    \definecolor{AtelierExample}{HTML}{48612A}
}

% Variant linen
\def\atelier@variant@linen{
    \definecolor{AtelierPaper}{HTML}{F2F3F0}
    \definecolor{AtelierPanel}{HTML}{E3E6E1}
    \definecolor{AtelierInk}{HTML}{1F2326}
    \definecolor{AtelierMuted}{HTML}{575E63}
    \definecolor{AtelierRule}{HTML}{BFC6C2}
    \definecolor{AtelierAccent}{HTML}{2F5D8A}
    \definecolor{AtelierAlert}{HTML}{9A2530}

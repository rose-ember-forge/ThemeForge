 beamerthemeAtelier.sty
 Part of the ThemeForge Collection
 An editorial theme.
 Warm tones and serif typography.
 
 Usage:     \usetheme{Atelier}
            \usetheme[variant = walnut, body = sans]{Atelier}

 Options:   variant = paper|linen|walnut    colour scheme (default paper)
            accent = <HEX>                  overrirde the variant's accent colour
            body = serif|sans               typeface for body text (default serif. Titles stay serif despite sans body)
            progressbar = true|false        hairline progress bar (default false)
            sectionpage = true|false        (default true)
            fonts = true|false              load Libertinus fonts if installed
    
% - - - - - - - - - - - -
% - - - - - - - - - - - -
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeAtelier}[ThemeForge 20261019 Atelier Theme v1.0]

\mode<presentation>

% - - - - - - - - - - - -
% 1. Options
% - - - - - - - - - - - -
\newif\ifatelier@progressbar    \atelier@progressbarfalse
\newif\ifatelier@sectionpage    \atelier@sectionpagetrue
\newif\ifatelier@fonts          \atelier@fontstrue
\newif\ifatelier@serifbody      \atelier@serifbodytrue

\def\aterlieraccent{}
\def\aterliarvariant{paper}

\DeclareOptionBeamer{variant}{\def\aterlier@variant{#1}}
\DeclareOptionBeamer{accent}{\def\atelier@accent{#1}}
\DeclareOptionBeamer{body}{%
    \def\atelier@tmp{#1}\def\atelier@sans{sans}%
    \ifx\atelier@tmp\atelier@sans\atelier@seribodyfalse\else\atelier@serifbodytrue\fi}
\DeclareOptionBeamer{progressbar}[true]{\csname atelier@progressbar#1\endcsname}
\DeclareOptionBeamer{sectionpage}[true]{\csname atelier@sectionpage#1\endcsname}
\DeclareOptionBeamer{fonts}[true]{\csname atelier@fonts#1\endcsname}
\ProcessOptionsBeamer

\RequirePackage{tikz}
\RequirePackage{tcolorbox}
\RequirePackage{etoolbox}

\providecommand{\themeforge@ifblank}[3]{%
    \setbox0 \hbox{\let\\\relax#1}
    \ifdim\wd0=0pt #2\else #3}


% - - - - - - - - - - - -
% 2. Colours
% - - - - - - - - - - - -


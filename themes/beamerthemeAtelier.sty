}

% Variant walnut
\def\atelier@variant@walnut{
    \definecolor{AtelierPaper}{HTML}{241C17}
    \definecolor{AtelierPanel}{HTML}{33281F}
    \definecolor{AtelierInk}{HTML}{F2E8DA}
    \definecolor{AtelierMuted}{HTML}{C2B29F}
    \definecolor{AtelierRule}{HTML}{5A4A3C}

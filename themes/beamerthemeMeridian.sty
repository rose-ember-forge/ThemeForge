% - - - - - - - - - - - -
% - - - - - - - - - - - -
% beamerthemeMeridian.sty
%  Part of the ThemeForge Collection
%  A minimal theme. 
%  Clean and light.
%  A slim progress bar and section divider slides.

%  Usage:     \usetheme[options]{Meridian}

%  Options: 
%     variant = light|paper|dark      changes colour scheme (default light)
%     accent = <HEX code>             overrides the accent colour of the variant
%     progressbar = true|false        adds a slim progress bar in the footline (default true)
%     sectionpage = true|false        a full slide for each \section (default true)
%     fonts = true|false              load Fira Sans/Fira Mono if installed
 
% - - - - - - - - - - - -
% - - - - - - - - - - - -
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeMeridian}[ThemeForge 20261014 Meridian theme v1.0]

\mode<presentation>

% - - - - - - - - - - - -
% 1. Options
% - - - - - - - - - - - -
\newif\ifmeridian@progressbar \meridian@progressbartrue
\newif\ifmeridian@sectionpage \meridian@sectionpagetrue
\newif\ifmeridian@fonts       \meridian@fontstrue
\def\meridian@accent{}
\def\meridian@variant{light}

\DeclareOptionBeamer{variant}{\def\meridian@variant{#1}}
\DeclareOptionBeamer{accent}{\def\meridian@accent{#1}}
\DeclareOptionBeamer{progressbar}[true]{\csname meridian@progressbar#1\endcsname}
\DeclareOptionBeamer{sectionpage}[true]{\csname meridian@sectionpage#1\endcsname}
\DeclareOptionBeamer{fonts}[true]{\csname meridian@fonts#1\endcsname}
\ProcessOptionsBeamer

\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\RequirePackage{etoolbox}

% A helper command
% Used later in the theme
% Essentially, run #2 if #1 typesets nothing, else #3.
\providecommand{\themeforge@ifblank}[3]{%
    \setbox0\hbox{\let\\\relax#1}%
    \ifdim\wd0=0pt #2\else#3\fi}

% - - - - - - - - - - - -
% 2. Colours
% Same set of colours, switched around for each variant.
% - - - - - - - - - - - -

\def\meridian@variant@light{%
  \definecolor{MeridianPaper}{HTML}{FFFFFF}
  \definecolor{MeridianInk}{HTML}{1F2430}     % 15.5 / 13.2
  \definecolor{MeridianMuted}{HTML}{5A6070}   %  6.3 /  5.3
  \definecolor{MeridianTrack}{HTML}{E4E6EC}   % decorative
  \definecolor{MeridianAccent}{HTML}{3043B8}  %  8.0 /  6.8
  \definecolor{MeridianAlert}{HTML}{B3261E}   %  6.5 /  5.6
  \definecolor{MeridianExample}{HTML}{1A7346} %  5.9 /  5.0
  \definecolor{MeridianOnAccent}{HTML}{FFFFFF}}
\def\meridian@variant@paper{%
  \definecolor{MeridianPaper}{HTML}{F8F6F1}
  \definecolor{MeridianInk}{HTML}{24211D}     % 14.8 / 12.8
  \definecolor{MeridianMuted}{HTML}{5E5850}   %  6.5 /  5.6
  \definecolor{MeridianTrack}{HTML}{E6E1D6}
  \definecolor{MeridianAccent}{HTML}{1F5F8B}  %  6.3 /  5.5
  \definecolor{MeridianAlert}{HTML}{A8321C}   %  6.2 /  5.4
  \definecolor{MeridianExample}{HTML}{2F6B2A} %  6.0 /  5.2
  \definecolor{MeridianOnAccent}{HTML}{FFFFFF}}
\def\meridian@variant@dark{%
  \definecolor{MeridianPaper}{HTML}{16181D}
  \definecolor{MeridianInk}{HTML}{E8EAEE}     % 14.7 / 12.6
  \definecolor{MeridianMuted}{HTML}{A2A8B4}   %  7.4 /  6.4
  \definecolor{MeridianTrack}{HTML}{2C3038}
  \definecolor{MeridianAccent}{HTML}{8C9EFF}  %  7.1 /  6.1
  \definecolor{MeridianAlert}{HTML}{FF8F80}   %  8.0 /  6.9
  \definecolor{MeridianExample}{HTML}{7FD49B} % 10.0 /  8.5
  \definecolor{MeridianOnAccent}{HTML}{16181D}}
\ifcsname meridian@variant@\meridian@variant\endcsname
  \csname meridian@variant@\meridian@variant\endcsname
\else
  \PackageWarning{beamerthemeMeridian}{Unknown variant `\meridian@variant',
    using `light'. Choose light, paper or dark}%
  \meridian@variant@light
\fi
\ifx\meridian@accent\@empty\else
  \definecolor{MeridianAccent}{HTML}{\meridian@accent}
\fi

\setbeamercolor{background canvas}{bg=MeridianPaper}
\setbeamercolor{normal text}{fg=MeridianInk, bg=MeridianPaper}
\setbeamercolor{structure}{fg=MeridianAccent}
\setbeamercolor{alerted text}{fg=MeridianAlert}
\setbeamercolor{example text}{fg=MeridianExample}
\setbeamercolor{title}{fg=MeridianInk}
\setbeamercolor{subtitle}{fg=MeridianMuted}
\setbeamercolor{author}{fg=MeridianInk}
\setbeamercolor{institute}{fg=MeridianMuted}
\setbeamercolor{date}{fg=MeridianMuted}
\setbeamercolor{frametitle}{fg=MeridianInk}
\setbeamercolor{framesubtitle}{fg=MeridianMuted}
\setbeamercolor{frametitle eyebrow}{fg=MeridianAccent}
\setbeamercolor{footline}{fg=MeridianMuted}
\setbeamercolor{section number}{fg=MeridianAccent}
\setbeamercolor{section title}{fg=MeridianInk}
\setbeamercolor{block title}{fg=MeridianAccent}
\setbeamercolor{block title alerted}{fg=MeridianAlert}
\setbeamercolor{block title example}{fg=MeridianExample}
\setbeamercolor{standout}{fg=MeridianOnAccent, bg=MeridianAccent}


% - - - - - - - - - - - -
% 3. Fonts
% - - - - - - - - - - - -

\ifmeridian@fonts
  \IfFileExists{FiraSans.sty}{\RequirePackage[sfdefault,lining]{FiraSans}}{}
  \IfFileExists{FiraMono.sty}{\RequirePackage[scale=0.88]{FiraMono}}{}
\fi
\usefonttheme{professionalfonts}

\setbeamerfont{title}{size=\LARGE, series=\bfseries}
\setbeamerfont{subtitle}{size=\large, series=\mdseries}
\setbeamerfont{author}{size=\normalsize, series=\bfseries}
\setbeamerfont{institute}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize, series=\mdseries}
\setbeamerfont{frametitle eyebrow}{size=\scriptsize, series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamerfont{section number}{size=\fontsize{48}{50}\selectfont, series=\bfseries}
\setbeamerfont{section title}{size=\LARGE, series=\bfseries}
\setbeamerfont{block title}{size=\normalsize, series=\bfseries}
\setbeamerfont{standout}{size=\Huge, series=\bfseries}


% - - - - - - - - - - - -
% 4. Geometry
% - - - - - - - - - - - -
\def\meridian@margin{0.07\paperwidth}
\setbeamersize{text margin left=0.07\paperwidth, text margin right=0.07\paperwidth}
\setbeamertemplate{navigation symbols}{}


% - - - - - - - - - - - -
% 5. Title Page
% - - - - - - - - - - - -

\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture, overlay]
    \fill[MeridianAccent] (current page.north west) rectangle
      ([xshift=0.012\paperwidth]current page.south west);
  \end{tikzpicture}%
  \vfill
  \begin{minipage}{0.86\textwidth}
    \raggedright
    {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
    \themeforge@ifblank{\insertsubtitle}{}{%
      \vskip0.8ex
      {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}}
    \vskip2.2ex
    {\color{MeridianAccent}\rule{3em}{2pt}\par}
    \vskip2.2ex
    {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
    \themeforge@ifblank{\insertinstitute}{}{%
      \vskip0.4ex
      {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}}
    \vskip0.4ex
    {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
  \end{minipage}
  \vfill\vfill
}


% - - - - - - - - - - - -
% 6. Frame title
% - - - - - - - - - - - -

\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth, leftskip=\meridian@margin,
                         rightskip=\meridian@margin plus 1fil]{frametitle}%
    \vskip1.9ex
    \themeforge@ifblank{\insertsectionhead}{}{%
      {\usebeamerfont{frametitle eyebrow}\usebeamercolor[fg]{frametitle eyebrow}%
       \insertsectionhead\par}\vskip0.5ex}%
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
    \themeforge@ifblank{\insertframesubtitle}{}{%
      \vskip0.3ex
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}}%
    \vskip0.8ex
    {\color{MeridianAccent}\rule{2.2em}{1.6pt}\par}%
    \vskip0.4ex
  \end{beamercolorbox}%
}


% - - - - - - - - - - - -
% 7. Footline
% Contains short title, frame number and a progress bar
% - - - - - - - - - - - -

\newcommand\meridian@progressbar{%
  \pgfmathsetmacro\meridian@ratio{min(1,\insertframenumber/max(1,\inserttotalframenumber))}%
  \begin{tikzpicture}
    \fill[MeridianTrack] (0,0) rectangle (\paperwidth,2.5pt);
    \fill[MeridianAccent] (0,0) rectangle ({\meridian@ratio*\paperwidth},2.5pt);
  \end{tikzpicture}}

\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=2.6ex, dp=1.6ex,
                         leftskip=\meridian@margin, rightskip=\meridian@margin]{footline}%
    \usebeamerfont{footline}\insertshorttitle\hfill
    \insertframenumber\,/\,\inserttotalframenumber
  \end{beamercolorbox}%
  \ifmeridian@progressbar\par\nointerlineskip\meridian@progressbar\fi
}


% - - - - - - - - - - - -
% 8. Section title slides
% - - - - - - - - - - - -

\setbeamertemplate{section page}{%
  \begin{minipage}{\textwidth}
    \raggedright
    {\usebeamerfont{section number}\usebeamercolor[fg]{section number}%
     \ifnum\value{section}<10 0\fi\insertsectionnumber\par}
    \vskip1ex
    {\usebeamerfont{section title}\usebeamercolor[fg]{section title}\insertsectionhead\par}
  \end{minipage}%
}
\AtBeginSection{%
  \ifmeridian@sectionpage
    \begingroup
      \setbeamertemplate{footline}{%
        \ifmeridian@progressbar\vskip0pt\meridian@progressbar\fi}
      \frame[c,noframenumbering]{\sectionpage}%
    \endgroup
  \fi}


% - - - - - - - - - - - -
% 9. Lists
% - - - - - - - - - - - -

\setbeamertemplate{itemize item}{\raisebox{0.3ex}{\tikz\fill[MeridianAccent] (0,0) circle (0.3ex);}}
\setbeamertemplate{itemize subitem}{\raisebox{0.3ex}{\tikz\draw[MeridianAccent, line width=0.6pt] (0,0) circle (0.25ex);}}
\setbeamertemplate{itemize subsubitem}{\raisebox{0.35ex}{\tikz\fill[MeridianMuted] (0,0) rectangle (0.4ex,0.4ex);}}
\setbeamertemplate{enumerate item}{\usebeamercolor[fg]{structure}\bfseries\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\usebeamercolor[fg]{structure}\insertsubenumlabel}
\setbeamertemplate{enumerate subsubitem}{\usebeamercolor[fg]{structure}\insertsubsubenumlabel}
\setlength{\leftmargini}{1.4em}
\AtBeginEnvironment{itemize}{\addtolength{\itemsep}{0.35ex}}
\AtBeginEnvironment{enumerate}{\addtolength{\itemsep}{0.35ex}}

% Table of contents: accent numbers, ink titles
\setbeamertemplate{section in toc}{%
  {\usebeamercolor[fg]{structure}\bfseries\ifnum\inserttocsectionnumber<10 0\fi\inserttocsectionnumber}%
  \hspace{1em}{\usebeamercolor[fg]{normal text}\inserttocsection}\par}
\setbeamertemplate{subsection in toc}{%
  \hspace{2.6em}{\usebeamercolor[fg]{normal text}\small\inserttocsubsection}\par}


% - - - - - - - - - - - -
% 10. Blocks
% - - - - - - - - - - - -

\tcbset{
  meridian/base/.style={enhanced, sharp corners, frame hidden, boxrule=0pt,
    left=8pt, right=8pt, top=3pt, bottom=5pt, toptitle=5pt, bottomtitle=0pt,
    titlerule=0pt, before skip=0.8ex, after skip=0.8ex,
    colupper=MeridianInk, fonttitle=\usebeamerfont{block title}},
  meridian/block/.style={meridian/base, colback=#1!10!MeridianPaper, colbacktitle=#1!10!MeridianPaper,
    coltitle=#1, borderline west={3pt}{0pt}{#1}},
}
\newcommand\meridian@blockbegin[1]{%
  \par
  \themeforge@ifblank{\insertblocktitle}%
    {\begin{tcolorbox}[meridian/block=#1]}%
    {\begin{tcolorbox}[meridian/block=#1, title={\insertblocktitle}]}%
  \usebeamercolor[fg]{normal text}}
\setbeamertemplate{block begin}{\meridian@blockbegin{MeridianAccent}}
\setbeamertemplate{block end}{\end{tcolorbox}}
\setbeamertemplate{block alerted begin}{\meridian@blockbegin{MeridianAlert}}
\setbeamertemplate{block alerted end}{\end{tcolorbox}}
\setbeamertemplate{block example begin}{\meridian@blockbegin{MeridianExample}}
\setbeamertemplate{block example end}{\end{tcolorbox}}


% - - - - - - - - - - - -
% 11. Miscellaneous 
% - - - - - - - - - - - -

\setbeamertemplate{caption}[numbered]
\setbeamercolor{caption name}{fg=MeridianAccent}
\setbeamerfont{caption}{size=\small}

% \begin{frame}[standout] ... \end{frame}  ->  full-bleed accent slide,
% not counted in the frame total. Settings stay local to that frame.
\newif\ifmeridian@standout
\define@key{beamerframe}{standout}[true]{%
  \setkeys{beamerframe}{c,noframenumbering}%
  \meridian@standouttrue
  \begingroup
  \setbeamercolor{background canvas}{bg=MeridianAccent}%
  \setbeamercolor{normal text}{fg=MeridianOnAccent, bg=MeridianAccent}%
  \setbeamercolor{alerted text}{fg=MeridianOnAccent}%
  \setbeamertemplate{footline}{}%
  \setbeamertemplate{frametitle}{}%
  \centering\usebeamerfont{standout}\color{MeridianOnAccent}}
\apptocmd{\beamer@reseteecodes}{%
  \ifmeridian@standout\endgroup\global\meridian@standoutfalse\fi}{}{}

\mode<all>
\endinput

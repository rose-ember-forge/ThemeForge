# ThemeForge .gitignore
# Rule of thumb: commit what you wrote, ignore what a command can rebuild.

# --- LaTeX build artefacts ---
*.aux
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.xdv
*.bbl
*.blg
*.bcf
*.run.xml
_minted*/

# --- Compiled output (rebuilt from source) ---
*.pdf
build/
site/dist/
anvil/
*.zip
# Uncomment the next line to push PDF demos
# !examples/showcase/*.pdf

# --- Python ---
__pycache__/
*.pyc
.venv/

# --- Editors ---
.vscode/
*.swp
*~

# --- OS clutter ---
Thumbs.db
desktop.ini
.DS_Store

# --- Ideas folder ---
Ideas/